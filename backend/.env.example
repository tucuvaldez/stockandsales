# Este archivo lo crea INSTALAR.bat como backend/.env. El MODO no se configura acá:
# lo elige el técnico en la instalación (y se cambia con tecnico/CAMBIAR_MODO.bat).

# Puerto de la aplicación (http://localhost:PUERTO)
PORT=3000

# 127.0.0.1 = solo esta PC (recomendado). 0.0.0.0 = también otras PCs de la red local.
HOST=127.0.0.1

# Carpeta de datos (base, copias y registros). Por defecto: carpeta "data" junto al programa.
# STOCKLOCAL_DATA=D:\StockLocalDatos
