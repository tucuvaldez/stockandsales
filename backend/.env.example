# Modo de funcionamiento disponible: local | facturacion | billing
APP_MODE=local

# Puerto del backend
PORT=5000

# MongoDB local
MONGO_URI=mongodb://127.0.0.1:27017/stocklocal

# Seleccioná 'local' para gestión de stock y ventas simples.
# Seleccioná 'facturacion' para activar tipo A, B, C, consumidor final y módulos de facturación.

# Seguridad / autenticación
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@stocklocal.local
ADMIN_PASSWORD=admin123
